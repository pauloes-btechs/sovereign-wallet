{
  "name": "sovereign-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Noncustodial Bitcoin & Lightning wallet — Wavelength everyday mode and litd advanced mode behind one dark, minimalist interface.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "web:dev": "pnpm --filter '@sovereign/mobile^...' build && pnpm --filter @sovereign/mobile web:dev",
    "web:build": "pnpm --filter '@sovereign/mobile^...' build && pnpm --filter @sovereign/mobile web:build",
    "test:integration": "cd services/litd-adapter && SOVEREIGN_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "test:recovery": "pnpm --filter @sovereign/harness-recovery test:integration",
    "harness:bootstrap": "node harness/regtest/dist/cli.js",
    "sidecar:fetch": "node scripts/fetch-sidecars.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "protobufjs": "8.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
