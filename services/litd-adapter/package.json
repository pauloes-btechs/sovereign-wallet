{
  "name": "@sovereign/litd-adapter",
  "version": "0.1.0",
  "description": "Mode B backend adapter: litd sidecar (LND + Loop + Pool + tapd + Faraday), gRPC via protobuf-ts against pinned LND protos. No grpc-web.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "SOVEREIGN_INTEGRATION=1 vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@lightninglabs/lnc-web": "0.3.6-alpha",
    "@sovereign/harness-regtest": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@sovereign/litd-proto": "workspace:*",
    "@sovereign/wallet-core": "workspace:*"
  }
}
