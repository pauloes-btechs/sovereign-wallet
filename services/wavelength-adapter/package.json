{
  "name": "@sovereign/wavelength-adapter",
  "version": "0.1.0",
  "description": "Mode A backend adapter. ALL Wavelength SDK contact is isolated here — pinned SDK versions, golden-tested surface, never imported elsewhere.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lightninglabs/wavelength-core": "0.2.0",
    "@sovereign/payments": "workspace:*",
    "@sovereign/wallet-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
