{
  "name": "@sovereign/wavelength-adapter",
  "version": "0.1.0",
  "description": "Mode A backend adapter. ALL Wavelength SDK contact is isolated here — pinned SDK versions, golden-tested surface, never imported elsewhere.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
