{
  "name": "@sovereign/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Everyday-mode (Wavelength) presentational component library: dark, minimalist, fully props-driven, rendering only what the provider declares.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./copy": {
      "types": "./dist/copy.d.ts",
      "default": "./dist/copy.js"
    },
    "./totals": {
      "types": "./dist/totals.d.ts",
      "default": "./dist/totals.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@sovereign/wallet-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
