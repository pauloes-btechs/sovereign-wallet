{
  "name": "@sovereign/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app: Tauri 2 + React + Vite. Daemons (`litd`, later `waved`) run as signed sidecar processes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "e2e": "playwright test",
    "test:e2e:modeb": "playwright test -c playwright.modeb.config.ts"
  },
  "dependencies": {
    "@sovereign/daemon-lifecycle": "workspace:*",
    "@sovereign/payments": "workspace:*",
    "@sovereign/privacy": "workspace:*",
    "@sovereign/secure-store": "workspace:*",
    "@sovereign/ui": "workspace:*",
    "@sovereign/wallet-core": "workspace:*",
    "@sovereign/wavelength-adapter": "workspace:*",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@sovereign/harness-regtest": "workspace:*",
    "@sovereign/litd-adapter": "workspace:*",
    "@sovereign/litd-proto": "workspace:*",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
